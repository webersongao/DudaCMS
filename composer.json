{
    "name": "dudacms/web",
    "description": "DudaCMS ：基于 TP8 的社交化知识付费问答与企业内部知识库系统",
    "license": "proprietary",
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "require": {
        "php": ">=8.2",
        "topthink/framework": "^8.1",
        "topthink/think-orm": "^4.0",
        "topthink/think-view": "^2.0",
        "topthink/think-template": "^3.0",
        "topthink/think-trace": "^2.0",
        "topthink/think-helper": "^3.1",
        "overtrue/pinyin": "^4.0",
        "phpoffice/phpspreadsheet": "^5.10",
        "ext-json": "*",
        "ext-iconv": "*",
        "ext-zip": "*",
        "ext-curl": "*",
        "ramsey/uuid": "^4.9",
        "phpmailer/phpmailer": "^6.9",
        "ezyang/htmlpurifier": "^4.19",
        "endroid/qr-code": "^6.0",
        "ext-gd": "*",
        "ext-zlib": "*",
        "elasticsearch/elasticsearch": "^8.19",
        "ext-openssl": "*",
        "topthink/think-filesystem": "^3.0",
        "npm-asset/dropzone": "^6.3.5",
        "npm-asset/codemirror": "6.0.2",
        "npm-asset/tom-select": "^2.7.0",
        "npm-asset/photoswipe": "^5.4.4",
        "npm-asset/bootstrap": "5.3.9",
        "npm-asset/admin-lte": "4.10.2",
        "alibabacloud/dysmsapi-20170525": "1.0.1",
        "tencentcloud/sms": "3.0.573"
    },
    "autoload": {
        "psr-4": {
            "app\\": "app"
        },
        "psr-0": {
            "": "extend/"
        },
        "files": [
            "app/function.inc.php"
        ]
    },
    "extra": {
        "installer-types": ["npm-asset", "bower-asset", "dudacms-asset"],
        "installer-paths": {
            "public/static/vendor/{$name}/": [
                "type:npm-asset",
                "type:bower-asset",
                "type:dudacms-asset"
            ]
        }
    },
    "config": {
        "preferred-install": "dist",
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "php-http/discovery": true,
            "composer/installers": true,
            "oomphinc/composer-installers-extender": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php think service:discover",
            "@php think vendor:publish"
        ]
    }
}
