<!DOCTYPE html
    PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title>[#subject#]</title>
</head>

<body style="background: #f6f6f6;">
    <style>
        a,
        a:hover,
        a:visited,
        a:focus {
            color: #3182f7;
            list-style: none !important;
            text-decoration: none !important
        }
    </style>
    <table border="0" class="emailBox" cellpadding="0" cellspacing="0" height="100%" width="100%"
        style="background: #f6f6f6;">
        <tr>
            <td align="center" valign="top">
                <table border="0" cellpadding="0" cellspacing="0" width="" style="background: #fff;margin: 15px 0">
                    <tr>
                        <td>
                            <div style="margin-top: 30px;margin-bottom: 5px;text-align: center;">
                                <a href="[#site_url]" target="_blank">
                                    <img src="[#site_url]/static/brand/logo-dudacms.svg" alt="[#site_name#]"
                                        style="width: auto;height: 38px;">
                                </a>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div style="margin: 30px;">
                                <div style="background:#f6f6f6;border-radius: 10px;padding: 20px ">
                                    <p style="font-size: 16px;margin: 0"><label style="font-weight: bold">
                                            [#user_name#]</label>&nbsp; 您好！</p>
                                    <div
                                        style="font-size: 16px;text-indent: 2rem;margin-top: 20px;line-height: 1.75rem;">
                                        [#message#]</div>
                                </div>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div style="margin:0 40px 10px;text-align: right;">
                                <p style="font-size: 14px;margin: 0">[#site_name#]运营团队</p>
                                <label style="font-size: 14px;">[#time#]</label>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div align="right" style="margin:15px 40px;border-top: solid 1px gray;padding-top: 10px"
                                id="bottomTime">
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <div style="text-align: center;font-size: 12px;">
                                <div style="padding-top: .5rem">
                                    <a href="[#site_url]/page/index.html?url_name=about" target="_blank"
                                        rel="noopener noreferrer">关于我们</a> |
                                    <a href="[#site_url]/page/index.html?url_name=rule" target="_blank"
                                        rel="noopener noreferrer">社区规范</a>
                                </div>
                                <div style="padding-top: .5rem !important;">
                                    <span>© 2018 - 2024 [#site_name#] All Rights Reserved.</span>
                                </div>
                                <p style="font-size: 10px;margin: 5px 15px 10px 15px;">
                                    此为系统邮件，请勿直接回复, 了解更多, 请点击 | <a href="[#site_url]/setting/notify"
                                        target="_blank">修改通知设置</a> </p>
                            </div>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>

</html>