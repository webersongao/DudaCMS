APP_DEBUG=false

[APP]
; 附件 AES 参数（部署时请改为随机值）
CRYPTO_KEY =
CRYPTO_IV =
; Cookie/Token/缓存前缀（多站点部署务必区分）
COOKIE_NAME =
COOKIE_PREFIX =
CACHE_PREFIX =
TOKEN_KEY =
DEFAULT_TIMEZONE=Asia/Shanghai

[DATABASE]
TYPE=mysql
HOSTNAME=127.0.0.1
DATABASE=test
USERNAME=username
PASSWORD=password
HOSTPORT=3306
CHARSET=utf8mb4
DEBUG=false

[LANG]
default_lang=zh-cn

[API]
; API v1 JWT 签名密钥（生产必须改为至少 32 位随机字符串）
JWT_SECRET =
; 跨域白名单，多个用英文逗号分隔；留空=只允许同源
ALLOW_ORIGINS =

[COOKIE]
; HTTPS 部署建议 true；留空时按请求协议自动判断
SECURE =

